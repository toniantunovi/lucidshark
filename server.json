{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.toniantunovi/lucidshark",
  "title": "LucidShark",
  "description": "Local code quality and security scanner: lint, types, SAST, SCA, tests, coverage.",
  "repository": {
    "url": "https://github.com/toniantunovi/lucidshark",
    "source": "github"
  },
  "version": "0.10.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "lucidshark",
      "version": "0.10.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {"type": "positional", "value": "serve"},
        {"type": "positional", "value": "--mcp"},
        {"type": "positional", "value": "."}
      ]
    }
  ]
}
